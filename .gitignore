# ---------------------------------------------------------------------------
# Veil state & sandbox machinery — NEVER commit (secrets, user data, caches)
# ---------------------------------------------------------------------------
/db/*
# …but the sanitized schema-only seed IS committed: serverless deploys
# (Vercel import) copy it to /tmp on cold boot, then restore the chat from
# the committed backup JSON — no secrets, no password hashes, 0 rows.
!/db/seed.db
/upload/
# Whole-box tar snapshots stay local-only (big, box-specific)…
/backups/*
# …but the CHAT backup snapshots are the point of the jsDelivr idea: they
# are committed to the public repo so they live at
# cdn.jsdelivr.net/gh/adimchinakamn-tech/veil-os@main/backups/chat/latest.json
!/backups/chat/
# the live-origin beacon — the jsDelivr fronts follow it to self-heal
# when the preview session moves (see scripts/retarget-fronts.mjs)
!/backups/live-origin.json
# local-only loop state (change fingerprint / last push result)
/backups/chat/.state.json
/backups/chat/loop.log
/tmp/
/tool-results/
/tests/
/.mbgs-cache/
/.zscripts/
/qa-shots/
*.db
*.db-journal
!db/seed.db
*.key
*.tar.gz
*.zip
# the served jsDelivr-front code download (user-facing asset, 135KB)
!/public/veil-jsdelivr-front.zip
# the one-click jsDelivr mirror bundle (user-facing asset, 2.0MB)
!/dl/veil-os-fronts.zip

scripts/veil-keeper.sh
veil-keeper.sh
# the handover worklog MUST ride with the repo — it's how revert recovery
# knows what was done (the keeper restores the tree from git too)
!worklog.md
.quasar-cache/
